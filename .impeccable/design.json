  "components": [
    {
      "name": "Botão principal",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ação principal vermelha com relevo interno e resposta curta ao pressionar.",
      "html": "<button class=\"ds-button-primary\" type=\"button\">Abrir perfis</button>",
      "css": ".ds-button-primary{min-height:40px;padding:8px 12px;border:1px solid #73846c;border-radius:7px;font-family:\"Segoe UI\",system-ui,sans-serif;font-size:13px;line-height:1.5;cursor:pointer;transition:background-color 120ms ease-out,transform 120ms ease-out;background:var(--primary-button,#bb283b);color:#fff9ee;border-color:#821b2a;box-shadow:inset 0 2px 2px #ed7d8877,inset 0 -2px 0 #8c2030;font-weight:750}.ds-button-primary:hover:not(:disabled){background:#a21f32;color:white}.ds-button-primary:active:not(:disabled){transform:translateY(1px);box-shadow:inset 0 1px 2px #64765c44}.ds-button-primary:disabled{opacity:.52;box-shadow:none;cursor:default}.ds-button-primary:focus-visible{outline:3px solid var(--focus,#007887);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none;animation:none}}"
    },
    {
      "name": "Botão secundário",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Controles cotidianos claros, usados ao lado de dados e filtros.",
      "html": "<button class=\"ds-button-secondary\" type=\"button\">Atualizar</button>",
      "css": ".ds-button-secondary{min-height:40px;padding:8px 12px;border:1px solid #73846c;border-radius:7px;font-family:\"Segoe UI\",system-ui,sans-serif;font-size:13px;line-height:1.5;cursor:pointer;transition:background-color 120ms ease-out,transform 120ms ease-out;background:var(--control-bg,#f5f6e9);color:var(--text,#1b3028);box-shadow:inset 0 -2px 0 #bcc9ae}.ds-button-secondary:hover:not(:disabled){background:#d9ead0;border-color:#4b6950}.ds-button-secondary:active:not(:disabled){transform:translateY(1px);box-shadow:inset 0 1px 2px #64765c44}.ds-button-secondary:disabled{opacity:.52;box-shadow:none;cursor:default}.ds-button-secondary:focus-visible{outline:3px solid var(--focus,#007887);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition:none;animation:none}}"
    },
    {
      "name": "Controle de som",
      "kind": "button",
      "refersTo": "button-sound",
      "description": "Alterna Som ligado/Sem som com aria-pressed. O aplicativo persiste idlebot.sound.enabled; bipes Web Audio de 95ms, onda quadrada e ganho máximo 0,035. Esta prévia é visual e não reproduz áudio.",
      "html": "<button class=\"ds-sound\" type=\"button\" aria-label=\"Sons de 8 bits\" aria-pressed=\"true\"><span class=\"ds-sound-icon\" aria-hidden=\"true\"></span><span>Som ligado</span></button>",
      "css": ".ds-sound{min-height:40px;padding:8px 12px;border:1px solid #73846c;border-radius:7px;font-family:\"Segoe UI\",system-ui,sans-serif;font-size:13px;line-height:1.5;cursor:pointer;transition:background-color 120ms ease-out,transform 120ms ease-out;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:38px;padding:7px 10px;background:#ab2434;color:#fff8eb;border-color:#7a1c29;box-shadow:inset 0 1px 2px #ef8f9366;font-size:12px}.ds-sound:hover:not(:disabled){background:#8c1b2b;border-color:#721925}.ds-sound-icon{width:17px;height:17px;display:inline-block;background:linear-gradient(currentColor,currentColor) 0 6px/3px 5px no-repeat,linear-gradient(currentColor,currentColor) 5px 3px/3px 11px no-repeat,linear-gradient(currentColor,currentColor) 10px 0/3px 17px no-repeat,linear-gradient(currentColor,currentColor) 15px 5px/2px 7px no-repeat}.ds-sound[aria-pressed=\"false\"] .ds-sound-icon{background-size:3px 2px,3px 2px,3px 2px,2px 2px;background-position-y:8px}.ds-sound:active:not(:disabled){transform:translateY(1px);box-shadow:inset 0 1px 2px #64765c44}.ds-sound:disabled{opacity:.52;box-shadow:none;cursor:default}.ds-sound:focus-visible{outline:3px solid var(--focus,#007887);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-sound{transition:none;animation:none}}"
    },
    {
      "name": "Campo de busca",
      "kind": "input",
      "refersTo": "input-search",
      "description": "Campo claro com rótulo permanente; ocupa uma linha inteira da barra de filtros no celular.",
      "html": "<label class=\"ds-search-label\">Buscar Pokémon<input class=\"ds-search\" type=\"search\" placeholder=\"Nome, apelido ou ID\"></label>",
      "css": ".ds-search-label{display:grid;gap:4px;min-width:0;color:var(--muted,#4d604c);font-family:\"Segoe UI\",system-ui,sans-serif;font-size:12px;font-weight:600}.ds-search{min-height:40px;max-width:100%;min-width:0;padding:8px 12px;border:1px solid #73846c;border-radius:7px;background:var(--control-bg,#f5f6e9);color:var(--text,#1b3028);caret-color:var(--casing-dark,#941c2d);font-family:\"Segoe UI\",system-ui,sans-serif;font-size:13px;line-height:1.5}.ds-search:focus-visible{outline:3px solid var(--focus,#007887);outline-offset:3px}"
    },
    {
      "name": "Teclas de navegação",
      "kind": "nav",
      "refersTo": "navigation-key",
      "description": "Navegação sobre a carcaça; aria-current troca a tecla ativa para a cor marfim da tela.",
      "html": "<nav class=\"ds-navigation\" aria-label=\"Seções do IdleBot\"><a href=\"#caca\" aria-current=\"page\">Caça</a><a href=\"#colecao\">Meus Pokémon</a><a href=\"#mercado\">Mercado</a></nav>",
      "css": ".ds-navigation{display:flex;justify-content:center;gap:8px;padding:12px;background:var(--casing,#cf3442);font-family:\"Segoe UI\",system-ui,sans-serif;}.ds-navigation a{display:flex;align-items:center;justify-content:center;min-height:48px;padding:10px 23px;border:1px solid #761c2a;border-radius:8px;background:#b82437;color:#fff9ee;box-shadow:inset 0 2px 2px #ee8c9377,0 2px 3px #771a2955;font-size:15px;font-weight:700;white-space:nowrap;text-decoration:none}.ds-navigation a:hover{background:#9e2131}.ds-navigation a[aria-current]{background:var(--bg,#f2f2e3);color:var(--text,#1b3028);border-color:var(--screen-border,#354537);box-shadow:inset 0 -3px 0 #b9cab0,0 2px 3px #771a2944}.ds-navigation a:focus-visible{outline:3px solid var(--focus,#007887);outline-offset:3px}@media(max-width:500px){.ds-navigation{gap:5px}.ds-navigation a{min-height:42px;padding:8px 5px;font-size:12px;border-radius:6px}}"
    },
    {
      "name": "Estado do perfil",
      "kind": "chip",
      "refersTo": "status-ready",
      "description": "Estado com texto, cor e ponto; pronto/caçando em verde, login em âmbar e reconexão em azul.",
      "html": "<div class=\"ds-status-row\"><span class=\"ds-status ds-ready\">Caçando</span><span class=\"ds-status ds-login\">Login</span><span class=\"ds-status ds-reconnecting\">Reconectando</span></div>",
      "css": ".ds-status-row{display:flex;flex-wrap:wrap;gap:8px}.ds-status{display:inline-flex;align-items:center;gap:6px;padding:5px 8px;border:1px solid #a9b69b;border-radius:5px;color:#45563d;background:#edf0df;white-space:normal;font-family:\"Segoe UI\",system-ui,sans-serif;font-size:11px;line-height:1.35}.ds-status:before{content:\"\";width:6px;height:6px;border-radius:50%;background:currentColor;flex:none}.ds-ready{background:#d4edbb;color:#28601b;border-color:#91b878}.ds-login{background:#ffe1a1;color:var(--warn,#75470c);border-color:#c29447}.ds-reconnecting{background:#d5eced;color:#235e6c;border-color:#9ebfc0}"
    },
